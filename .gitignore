# App cache
artifacts/guia-lojas/cache/

# Capacitor: as plataformas iOS e Android entram no git (o Codemagic compila a partir delas).
# Ficam de fora os regeneráveis: public volta com `cap sync`, Pods com `pod install`,
# build/outputs do Gradle e o keystore local (nunca versionar chaves).
artifacts/guia-lojas/ios/App/public/
artifacts/guia-lojas/ios/App/Pods/
artifacts/guia-lojas/ios/App/build/
artifacts/guia-lojas/android/app/build/
artifacts/guia-lojas/android/.gradle/
artifacts/guia-lojas/android/app/src/main/assets/public/
*.jks
*.keystore

# wrangler dry-run
.dry

# wrangler/logs locais
wrangler-login.log
wrangler-login.err
tail.log
